# Copy to .env.local and fill in. Never commit real values.

# Nexconn Console -> your app -> App Key / App Secret
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
# Server API domains for your app's data center (Console shows which one).
# Singapore: https://api.sg-light-api.com / https://api-b.sg-light-api.com
# North America: https://api.us-light-api.com / https://api-b.us-light-api.com
NEXCONN_API_BASE=https://api.sg-light-api.com
NEXCONN_API_BASE_BACKUP=https://api-b.sg-light-api.com
# Client SDK area code that matches the domain above: SG | NA | SA | OM | BJ
NEXCONN_AREA=SG

# Neon Postgres connection string (pooled)
DATABASE_URL=

# Protects /admin
ADMIN_TOKEN=

# Optional: enables "What did I miss?" AI catch-up (also needs NEXT_PUBLIC_FEATURE_AI_CATCHUP=1).
# Any OpenAI-compatible provider. Free, no card: Groq (https://console.groq.com/keys)
#   AI_BASE_URL=https://api.groq.com/openai/v1  AI_MODEL=openai/gpt-oss-120b  AI_FALLBACK_MODEL=openai/gpt-oss-20b
# Or OpenRouter free models: AI_BASE_URL=https://openrouter.ai/api/v1  AI_MODEL=<model>:free
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_FALLBACK_MODEL=
# Or just a Gemini key (uses Gemini Flash, falls back to Gemma). Needs billing on projects without free-tier access.
GEMINI_API_KEY=

# P2 feature flags (set to 1 to enable)
NEXT_PUBLIC_FEATURE_GHOST_CROWD=
NEXT_PUBLIC_FEATURE_WAVE=
NEXT_PUBLIC_FEATURE_AUTO_CALIBRATION=
NEXT_PUBLIC_FEATURE_AI_CATCHUP=
NEXT_PUBLIC_FEATURE_STADIUMS=
NEXT_PUBLIC_FEATURE_HUDDLE=
NEXT_PUBLIC_FEATURE_HINDI=
